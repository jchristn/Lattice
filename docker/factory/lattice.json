{
  "Logging": {
    "ConsoleLogging": true,
    "MinimumSeverity": 6,
    "LogFilename": "/app/logs/lattice.log"
  },
  "Rest": {
    "Hostname": "+",
    "Port": 8000,
    "Ssl": false,
    "SslCertificateFile": null,
    "SslCertificatePassword": null,
    "Cors": {
      "Enable": true,
      "AllowOrigins": [ "*" ],
      "AllowMethods": [ "GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS" ],
      "AllowHeaders": [ "*" ],
      "ExposeHeaders": [ "Content-Type", "X-Requested-With", "X-Lattice-Request-Id" ],
      "AllowCredentials": false,
      "MaxAgeSeconds": 86400
    }
  },
  "Lattice": {
    "Database": {
      "Type": "Sqlite",
      "Filename": "/app/data/lattice.db",
      "Hostname": null,
      "Port": 0,
      "DatabaseName": null,
      "Username": null,
      "Password": null
    },
    "InMemory": false,
    "DefaultDocumentsDirectory": "/app/documents",
    "EnableLogging": false
  },
  "Auth": {
    "Enable": false
  },
  "Mcp": {
    "Enable": false
  }
}
