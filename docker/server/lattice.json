{
  "Logging": {
    "ConsoleLogging": true,
    "MinimumSeverity": 6,
    "LogFilename": "/app/logs/lattice.log"
  },
  "Rest": {
    "Hostname": "+",
    "Port": 8000,
    "Ssl": false,
    "SslCertificateFile": null,
    "SslCertificatePassword": null,
    "Cors": {
      "Enable": true,
      "AllowOrigins": [ "*" ],
      "AllowMethods": [ "GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS" ],
      "AllowHeaders": [ "*" ],
      "ExposeHeaders": [ "Content-Type", "X-Requested-With", "X-Lattice-Request-Id" ],
      "AllowCredentials": false,
      "MaxAgeSeconds": 86400
    }
  },
  "Lattice": {
    "Database": {
      "Type": "Sqlite",
      "Filename": "/app/data/lattice.db",
      "Hostname": null,
      "Port": 0,
      "DatabaseName": null,
      "Username": null,
      "Password": null
    },
    "InMemory": false,
    "DefaultDocumentsDirectory": "/app/documents",
    "EnableLogging": false
  },
  "Telemetry": {
    "Enable": true,
    "ServiceName": "lattice-server",
    "Otlp": { "Enable": true, "Endpoint": "http://otel-collector:4317", "Protocol": "Grpc", "TimeoutMs": 10000 },
    "Metrics": { "Enable": true, "ExportIntervalMs": 15000, "IncludeRuntime": true, "IncludeProcess": true },
    "Traces": { "Enable": true, "SamplingRatio": 1.0 },
    "Logs": { "Enable": true, "MinimumSeverity": 2 },
    "Prometheus": { "Enable": false, "Hostname": "localhost", "Port": 9464, "Path": "/metrics" },
    "Loki": { "Enable": false, "Endpoint": "http://localhost:3100/otlp", "TenantId": null }
  },
  "Auth": {
    "Enable": true,
    "TokenSecret": "lattice-token-secret-change-me",
    "SessionTtlMinutes": 60,
    "DefaultTenantName": "Default Tenant",
    "DefaultAdminEmail": "admin@lattice",
    "DefaultAdminPassword": "password"
  },
  "Mcp": {
    "Enable": true,
    "Path": "/v1.0/mcp",
    "ServerName": "lattice"
  }
}
