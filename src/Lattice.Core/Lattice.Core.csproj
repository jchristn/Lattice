<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<NoWarn>$(NoWarn);CS8632</NoWarn>
		<ApplicationIcon>logo.ico</ApplicationIcon>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Title>Lattice</Title>
		<Version>0.3.0</Version>
		<Authors>Joel Christner</Authors>
		<Description>Lattice is a JSON document store with real-time schema processing, indexing during ingestion, and a SQL-like interface for querying data</Description>
		<Copyright>(c)2026 Joel Christner</Copyright>
		<PackageProjectUrl>https://github.com/jchristn/lattice</PackageProjectUrl>
		<PackageIcon>logo.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/jchristn/lattice</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>json;document-store;storage;index;indexing;search;retrieval;rag;nosql;sql;telemetry;opentelemetry;observability;metrics;tracing</PackageTags>
		<PackageReleaseNotes>Adds built-in OpenTelemetry instrumentation (System.Diagnostics.Metrics and ActivitySource) across all core services, workflows, and the ingestion/search/index-rebuild paths via the Lattice.Core.Telemetry namespace. Emit rides the .NET base class library and is a no-op until a host subscribes to the "Lattice.Core" meter and activity source, so there is no new package dependency. See TELEMETRY.md.</PackageReleaseNotes>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<PackageId>Lattice</PackageId>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="logo.ico" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\assets\logo.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\LICENSE.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
		<PackageReference Include="MySqlConnector" Version="2.6.2" />
		<PackageReference Include="Npgsql" Version="10.0.3" />
		<PackageReference Include="PrettyId" Version="2.0.1" />
	</ItemGroup>

</Project>
